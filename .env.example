# Copy to .env to override the defaults used by compose.yaml (all optional).
DB_NAME=poke
DB_USER=poke
DB_PASSWORD=poke
DB_PORT=5432
APP_PORT=8080
WEB_PORT=3000
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
SPRING_PROFILES_ACTIVE=demo        # 'demo' pre-inserts the demo users; leave empty for an empty database
JWT_SECRET=demo-only-jwt-secret-replace-me-outside-demos   # HS256 key, at least 32 bytes
JWT_VALIDITY=1h
