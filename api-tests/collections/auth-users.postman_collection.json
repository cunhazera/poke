                  "pm.test(\"201 with the user, never the password\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(Object.keys(body)).to.have.members([\"id\", \"username\", \"email\", \"role\"]);",
