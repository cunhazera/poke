{
  "info": {
    "name": "Poke API - US02 Pokemon Detail",
    "_postman_id": "5c2a9e71-us02-poke-detail",
    "description": "Black-box tests for US02 (GET /api/v1/pokemon/{id}) against a running server backed by the live PokeAPI.\n\nRun: `api-tests/run.sh` (or `docker compose run --rm api-tests`), or import into Postman with the `local` environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Applies to every request",
          "pm.test(\"responds within 10 s (cold upstream fan-out included)\", () => pm.expect(pm.response.responseTime).to.be.below(10000));",
          "pm.test(\"no stack traces or internal hosts leak\", () => {",
          "    const text = pm.response.text();",
          "    pm.expect(text).to.not.match(/Exception|\\tat |127\\.0\\.0\\.1|pokeapi\\.co\\/api/);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "eeveeBody",
      "value": ""
    },
    {
      "key": "listedBulbasaur",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Happy path: chain shapes",
      "item": [
        {
          "name": "Ivysaur: a middle stage with its whole chain",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK with JSON\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"exact top-level contract\", () => {",
                  "    pm.expect(Object.keys(body)).to.have.members([\"id\", \"name\", \"category\", \"imageUrl\", \"spriteUrl\", \"description\",",
                  "        \"heightM\", \"weightKg\", \"types\", \"abilities\", \"stats\", \"evolutionChain\"]);",
                  "});",
                  "pm.test(\"identity, category, units converted to metres and kilograms\", () => {",
                  "    pm.expect(body.id).to.eql(2);",
                  "    pm.expect(body.name).to.eql(\"ivysaur\");",
                  "    pm.expect(body.category).to.eql(\"Seed Pokémon\");",
                  "    pm.expect(body.heightM).to.eql(1.0);",
                  "    pm.expect(body.weightKg).to.eql(13.0);",
                  "    pm.expect(body.types).to.eql([\"grass\", \"poison\"]);",
                  "});",
                  "pm.test(\"image is the official artwork, sprite is the small one\", () => {",
                  "    pm.expect(body.imageUrl).to.match(/official-artwork\\/2\\.png$/);",
                  "    pm.expect(body.spriteUrl).to.match(/sprites\\/pokemon\\/2\\.png$/);",
                  "});",
                  "pm.test(\"stats: six named values within 1..255 and a correct total\", () => {",
                  "    const s = body.stats;",
                  "    pm.expect(Object.keys(s)).to.have.members([\"hp\", \"attack\", \"defense\", \"specialAttack\", \"specialDefense\", \"speed\", \"total\"]);",
                  "    const six = [s.hp, s.attack, s.defense, s.specialAttack, s.specialDefense, s.speed];",
                  "    six.forEach(v => pm.expect(v).to.be.within(1, 255));",
                  "    pm.expect(s.total).to.eql(six.reduce((a, b) => a + b, 0));",
                  "    pm.expect(s).to.include({ hp: 60, attack: 62, defense: 63, specialAttack: 80, specialDefense: 80, speed: 60, total: 405 });",
                  "});",
                  "pm.test(\"description is clean prose: no game line breaks, form feeds or soft hyphens\", () => {",
                  "    pm.expect(body.description).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.description).to.not.match(/[\\n\\f\\u00ad]|\\s{2,}/);",
                  "});",
                  "pm.test(\"chain starts at bulbasaur and runs bulbasaur > ivysaur > venusaur\", () => {",
                  "    const c = body.evolutionChain;",
                  "    pm.expect(c.id).to.eql(1);",
                  "    pm.expect(c.evolvesTo.map(n => n.id)).to.eql([2]);",
                  "    pm.expect(c.evolvesTo[0].evolvesTo.map(n => n.id)).to.eql([3]);",
                  "    pm.expect(c.evolvesTo[0].evolvesTo[0].evolvesTo).to.eql([]);",
                  "});",
                  "pm.test(\"every stage has a name and a sprite\", () => {",
                  "    (function walk(n) {",
                  "        pm.expect(Object.keys(n)).to.have.members([\"id\", \"name\", \"spriteUrl\", \"evolvesTo\"]);",
                  "        pm.expect(n.name).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(n.spriteUrl).to.match(new RegExp(\"/\" + n.id + \"\\\\.png$\"));",
                  "        n.evolvesTo.forEach(walk);",
                  "    })(body.evolutionChain);",
                  "});"
                ]
              }
            }
          ],
